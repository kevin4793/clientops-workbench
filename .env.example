# 可选 — 演示环境可不配置

# 阿里云百炼 / 通义千问（仅服务端，高效录入 /api/intake/parse）
# DASHSCOPE_API_KEY=
# QWEN_VL_MODEL=qwen-vl-max
# QWEN_TEXT_MODEL=qwen-plus

# Grok Bot 调用 /api/integrations/grok-bot 时的 Bearer 校验
# GROK_BOT_WEBHOOK_SECRET=

# 未来 Notion 客户库同步
# NOTION_TOKEN=
# NOTION_DATABASE_ID=

# 部署后若需在前端展示公网 API 根（自定义集成时用）
# NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
