# === 生产必填（Vercel Environment Variables）===

# 单用户登录密码（自行设定强密码）
APP_PASSWORD=

# 会话签名密钥（随机长字符串，例：openssl rand -base64 32）
SESSION_SECRET=

# Neon Postgres（Vercel Marketplace → Neon → Connect，选 Singapore 等区域）
DATABASE_URL=

# AES-256-GCM 数据密钥：64 位十六进制（32 字节）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=

# Grok Bot 只读到期列表：GET /api/expiring?days=7
BOT_API_TOKEN=

# === 高效录入（可选）===
# DASHSCOPE_API_KEY=
# QWEN_VL_MODEL=qwen-vl-max
# QWEN_TEXT_MODEL=qwen-plus

# GROK_BOT_WEBHOOK_SECRET=
